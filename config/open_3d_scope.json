      "editable_geometry",
      "surface_topology",
      "materials_and_textures",
      "blender_execution",
      "inspection_and_revision",
      "asset_export"
    ],
    "interface_status": "planned",
    "current_plugin_or_mcp_integration": false
  },
  "training_objective": "Image-conditioned, editable 3D asset construction and measurable refinement; no general language-model or dialogue training",
  "active_scope": [
    "geometry_analysis",
    "image_shape_understanding",
    "geometry_construction",
    "surface_topology",
    "materials_textures",
    "inspection",
    "optimization",
    "asset_export",
    "assistant_tool_integration"
  ],
  "backend": "blender",
  "future_backend": "ai_native_geometry_engine",
  "lanes": {
