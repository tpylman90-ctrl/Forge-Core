<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Special access is granted separately by the user in Android Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Allow the user to choose installed launchable apps if usage history is empty. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:label="${forgeAppLabel}"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:icon="@mipmap/ic_forge"
        android:roundIcon="@mipmap/ic_forge">
        <activity android:name=".ForgeHomeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Existing teaching screen remains an internal activity for app and notifications. -->
        <activity android:name=".MainActivity" android:exported="false"/>
        <service
            android:name=".ObserveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_opt_in_learning_questions_from_allowlisted_app_usage_events"/>
        </service>
    </application>
</manifest>
